@media (prefers-color-scheme: dark) {
    body .aplayer {
        background: #333 !important;

        .aplayer-info {
            .aplayer-music {
                .aplayer-title {
                    color: #fff;
                }

                .aplayer-author {
                    color: #aaa;
                }
            }

            .aplayer-controller {
                .aplayer-bar-wrap {
                    .aplayer-bar {
                        background: #666;
                    }
                }

                .aplayer-time {
                    color: #999;

                    .aplayer-icon {
                        path {
                            fill: #aaa;
                        }

                        &:hover {
                            path {
                                fill: #fff;
                            }
                        }
                    }
                }

                .aplayer-volume-wrap {
                    .aplayer-volume-bar-wrap {
                        .aplayer-volume-bar {
                            background: #666;
                        }
                    }
                }
            }
        }

        .aplayer-lrc {
            &:before {
                background: linear-gradient(to bottom, rgba(51,51,51,1) 0%,rgba(51,51,51,0) 100%);
            }

            &:after {
                background: linear-gradient(to bottom, rgba(51,51,51,0) 0%,rgba(51,51,51,0.8) 100%);
            }

            p {
                color: #ccc;
                text-shadow: none !important;
            }

            p.aplayer-lrc-current {
                color: #fff;
                opacity: 1;
            }
        }

        .aplayer-list {
            ol {
                &::-webkit-scrollbar-thumb {
                    background-color: #222;
                }

                &::-webkit-scrollbar-thumb:hover {
                    background-color: #444;
                }

                li {
                    border-top: 1px solid #171717;

                    &:hover {
                        background: #111;
                    }

                    &.aplayer-list-light {
                        background: #171717;
                    }

                    .aplayer-list-index {
                        color: #aaa;
                    }
                    .aplayer-list-author {
                        color: #aaa;
                    }
                }
            }
        }

        .aplayer-notice {
            background-color: #ccc;
            color: #666;
        }

        .aplayer-miniswitcher {
            background: #1a1a1a;

            .aplayer-icon {
                path {
                    fill: #aaa;
                }

                &:hover {
                    path {
                        fill: #fff;
                    }
                }
            }
        }

        &.aplayer-fixed {
            .aplayer-list {
                border: 1px solid #222;
            }

            .aplayer-body {
                background: #333;
            }

            .aplayer-info {
                border-top: 1px solid #171717;
            }
        }
    }
}
